{
  "name": "specter-mirror-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm:build": "wasm-pack build ../crates/spook-web --target web --out-dir ../../web/generated --no-opt",
    "predev": "npm run wasm:build",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run wasm:build",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
