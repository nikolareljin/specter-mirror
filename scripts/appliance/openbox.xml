<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <desktops><number>1</number></desktops>
  <keyboard>
    <keybind key="C-A-Escape">
      <action name="Execute"><command>xterm -T SpecterMirror-maintenance</command></action>
    </keybind>
  </keyboard>
  <applications>
    <application class="*"><decor>no</decor></application>
    <application title="SpecterMirror - synthetic frame proof"><fullscreen>yes</fullscreen></application>
  </applications>
</openbox_config>
