#!/usr/bin/env bash
# SCRIPT: pre-commit
# DESCRIPTION: Refuse commits unless the configured local publication gate succeeds.
# USAGE: .githooks/pre-commit [-h|--help]
# PARAMETERS:
#   No arguments  Inspect staged content through publication.gate.
#   -h, --help    Print this header without inspecting or committing anything.
# REQUIREMENTS:
#   Git and an absolute executable file configured as publication.gate.
#   The shared hook installer must chain this repository callback.
# EXAMPLES:
#   .githooks/pre-commit --help
#   git config publication.gate /absolute/path/to/publication-check
#   .githooks/pre-commit
# EXIT_CODES:
#   0  Help printed or the publication gate succeeded.
#   1  The publication gate is missing or invalid.
#   Other nonzero values are propagated from the gate.

set -euo pipefail
if [[ $# -eq 1 && ( "$1" == -h || "$1" == --help ) ]]; then
  sed -n '2,/^$/s/^# \{0,1\}//p' "${BASH_SOURCE[0]}"
  exit 0
fi
gate="$(git config --get publication.gate || true)"
if [[ "$gate" != /* || ! -f "$gate" || ! -x "$gate" ]]; then
  echo "Publication gate must be an absolute executable file; commit refused." >&2
  exit 1
fi
exec "$gate" staged
