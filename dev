#!/usr/bin/env bash
# SCRIPT: dev
# DESCRIPTION: Run SpecterMirror development commands with the pinned Rust toolchain.
# USAGE: ./dev [command]
# PARAMETERS:
#   check         Format, clippy, workspace tests, WASM and i686 checks (default).
#   test          Run all Rust workspace tests.
#   all-test      Run Rust workspace, web (npm) and Python tests; report every failure.
#   build         Build the workspace for the host architecture.
#   build-i686    Link the release kiosk executable for i686 Linux.
#   fmt           Format all workspace Rust source files. This modifies files.
#   fmt-check     Check Rust formatting without modifying source files.
#   core-test     Run only spook-core tests.
#   wasm-check    Check the portable crates for wasm32-unknown-unknown.
#   i686-check    Check the complete workspace for i686-unknown-linux-gnu.
#   deps-check    List duplicate packages in the locked dependency graph.
#   docs-check    Check documentation links and print a review reminder.
#   native-proof  Render a synthetic frame in an X11 window, then exit.
#   native        Animate the generated native sample until Escape.
#   preview [..]  Play the web engine live in an X11 window on a generated visitor (--save
#                 writes PNG frames and a viewer). Options: ./dev preview --help.
#   -h, --help    Print this header without checking or building anything.
# REQUIREMENTS:
#   Rust commands need rustup and the toolchain in rust-toolchain.toml.
#   i686 native commands also need gcc-multilib and libc6-dev-i386 on Ubuntu.
#   native, native-proof and preview need X11; use xvfb-run for a virtual display.
#   preview --camera also needs ffmpeg and access to the /dev/video device.
#   docs-check needs Python 3. Help needs only Bash and sed.
#   all-test also needs Python 3 and Node.js; install web dependencies with npm ci --prefix web.
# EXAMPLES:
#   ./dev --help
#   ./dev core-test
#   ./dev all-test
#   ./dev wasm-check
#   ./dev preview --camera --show-face
#   ./dev build-i686
#   xvfb-run -a ./dev native-proof
# EXIT_CODES:
#   0  Help printed or the requested command succeeded.
#   1  At least one all-test suite failed.
#   2  Unknown command or too many arguments.
#   Other nonzero values are propagated from the selected tool.

set -euo pipefail
show_help() {
  sed -n '2,/^$/s/^# \{0,1\}//p' "${BASH_SOURCE[0]}"
}
if [[ $# -eq 1 && ( "$1" == -h || "$1" == --help ) ]]; then
  show_help
  exit 0
fi
if [[ $# -gt 1 && "$1" != preview ]]; then
  echo "Too many arguments. See ./dev --help for usage." >&2
  exit 2
fi
case "${1:-check}" in
  check|test|all-test|build|build-i686|fmt|fmt-check|core-test|wasm-check|i686-check|deps-check|native-proof|native|preview) ;;
  docs-check) exec python3 "$(dirname "${BASH_SOURCE[0]}")/scripts/check_docs.py" ;;
  *) echo "Unknown command. See ./dev --help for usage." >&2; exit 2 ;;
esac
cd "$(dirname "$0")"
if [[ "${1:-check}" == all-test ]]; then
  failed=()
  "$PWD/dev" test || failed+=("rust workspace")
  (cd web && npm test) || failed+=("web")
  python3 -m unittest discover -s tests -p 'test_*.py' || failed+=("python")
  if [[ ${#failed[@]} -gt 0 ]]; then
    echo "all-test: failed suites: ${failed[*]}" >&2
    exit 1
  fi
  echo "all-test: all suites passed"
  exit 0
fi
compiler="$(rustup which --toolchain 1.99.1 rustc)"
toolchain_bin="$(dirname "$compiler")"
export RUSTC="$compiler"
export PATH="$toolchain_bin:$PATH"
run_tests() {
  cargo test --locked --workspace
  cargo test --locked -p spook-web --example preview
}
case "${1:-check}" in
  check)
    cargo fmt --all -- --check
    cargo clippy --locked --workspace --all-targets -- -D warnings
    run_tests
    cargo check --locked -p spook-core -p spook-web --target wasm32-unknown-unknown
    cargo check --locked --workspace --target i686-unknown-linux-gnu ;;
  test) run_tests ;;
  build) cargo build --locked --workspace ;;
  build-i686)
    mirror_cargo_dir="${CARGO_HOME:-$HOME/.cargo}"
    if [[ "${CARGO_ENCODED_RUSTFLAGS+x}" == x ]]; then
      mirror_flags="$CARGO_ENCODED_RUSTFLAGS"
    else
      mirror_flags=""
      if [[ -n "${RUSTFLAGS:-}" ]]; then
        read -r -a mirror_existing_flags <<< "${RUSTFLAGS//$'\n'/ }"
        for mirror_flag in "${mirror_existing_flags[@]}"; do
          mirror_flags+="${mirror_flags:+$'\x1f'}$mirror_flag"
        done
      fi
    fi
    export CARGO_ENCODED_RUSTFLAGS="${mirror_flags:+$mirror_flags$'\x1f'}--remap-path-prefix=$PWD=/src/specter-mirror"$'\x1f'"--remap-path-prefix=$mirror_cargo_dir=/cargo"
    cargo build --locked -p spook-kiosk --release --target i686-unknown-linux-gnu ;;
  fmt) cargo fmt --all ;;
  fmt-check) cargo fmt --all -- --check ;;
  core-test) cargo test --locked -p spook-core ;;
  wasm-check) cargo check --locked -p spook-core -p spook-web --target wasm32-unknown-unknown ;;
  i686-check) cargo check --locked --workspace --target i686-unknown-linux-gnu ;;
  deps-check) cargo tree --locked --workspace --duplicates ;;
  native-proof) cargo run --locked -p spook-kiosk -- --self-test ;;
  native) cargo run --locked -p spook-kiosk ;;
  # Release build: the face detector is far too slow unoptimized.
  preview) shift; cargo run --locked --quiet --release -p spook-web --example preview -- "$@" ;;
esac
